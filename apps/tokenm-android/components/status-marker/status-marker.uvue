<template>
  <view :class="['status-marker', 'tone-' + tone]" :aria-label="label">
    <view class="status-dot"></view>
    <text class="status-label">{{ label }}</text>
  </view>
</template>

<script setup lang="uts">
type StatusMarkerProps = {
  tone?: string,
  label?: string
}

withDefaults(defineProps<StatusMarkerProps>(), {
  tone: 'neutral',
  label: ''
})
</script>

<style lang="scss">
.status-marker { min-width: 0; flex-direction: row; align-items: center; }
.status-dot { width: 6px; height: 6px; margin-right: 6px; border-radius: 3px; background-color: $tm-text-3; }
