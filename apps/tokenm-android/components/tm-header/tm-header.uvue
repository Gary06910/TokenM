  min-width: 0;
  flex: 1;
  color: $tm-text-1;
  font-size: 18px;
  font-weight: 600;
  line-height: 22px;
  text-align: center;
}
.header-control, .header-spacer { width: 48px; min-width: 48px; height: 48px; }
.header-control {
  align-items: center;
  justify-content: center;
  padding-top: 0;
  padding-right: 0;
  padding-bottom: 0;
  padding-left: 0;
  border-width: 1px;
  border-style: solid;
  border-color: $tm-line;
  border-radius: $tm-radius-md;
  color: $tm-text-1;
  background-color: $tm-surface-1;
  font-size: 13px;
  line-height: 46px;
