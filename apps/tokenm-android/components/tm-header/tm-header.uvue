<template>
  <view class="header">
    <button v-if="back" class="header-control" hover-class="header-control-active" aria-label="返回上一页" @click="goBack">返回</button>
    <view v-else class="header-spacer"></view>
    <text class="header-title">{{ title }}</text>
    <button v-if="actionText.length > 0" class="header-action" @click="emitAction">{{ actionText }}</button>
    <view v-else class="header-spacer"></view>
  </view>
</template>

<script setup lang="uts">
type TmHeaderProps = {
  title?: string,
  back?: boolean,
  actionText?: string
}

const props = withDefaults(defineProps<TmHeaderProps>(), {
  title: '',
  back: false,
  actionText: ''
})

const emit = defineEmits(['action'])

const goBack = () => {
  uni.navigateBack({
    fail: () => {
      uni.reLaunch({ url: '/pages/dashboard/index' })
    }
  })
}

const emitAction = () => {
  emit('action')
}
</script>

<style lang="scss">
