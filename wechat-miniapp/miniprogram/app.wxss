page {
  --tm-bg: #07111f;
  --tm-bg-raised: #0a1727;
  --tm-surface-1: #0d1b2b;
  --tm-surface-2: #122238;
  --tm-line: #20344d;
  --tm-line-strong: #315071;
  --tm-text-1: #f2f7ff;
  --tm-text-2: #b4c2d4;
  --tm-text-3: #7f91a7;
  --tm-accent: #3f86ff;
  --tm-accent-pressed: #2f6fd8;
  --tm-accent-soft: #132e55;
  --tm-success: #47c99a;
  --tm-warning: #f0b95b;
  --tm-danger: #ef7181;
  --tm-info: #69a5ff;
  --tm-skeleton: #15263a;
  min-height: 100%;
  color: var(--tm-text-1);
  background: var(--tm-bg);
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
  line-height: 1.65;
}

button { font: inherit; }
button::after { border: 0; }

.page {
  box-sizing: border-box;
  width: 100%;
  max-width: 750rpx;
  min-height: 100vh;
  margin: 0 auto;
  padding: calc(env(safe-area-inset-top) + 24rpx) 32rpx calc(152rpx + env(safe-area-inset-bottom));
  overflow-x: hidden;
}
.page-secondary { padding-bottom: calc(40rpx + env(safe-area-inset-bottom)); }
.page-title { margin: 24rpx 0 8rpx; font-size: 40rpx; font-weight: 650; line-height: 1.3; }
.page-lead { color: var(--tm-text-2); font-size: 28rpx; }
.section { margin-top: 40rpx; }
.section-head { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; margin-bottom: 16rpx; }
.section-title { font-size: 32rpx; font-weight: 600; line-height: 1.4; }
.section-link { min-height: 88rpx; padding: 0 8rpx; color: var(--tm-info); background: transparent; font-size: 26rpx; line-height: 88rpx; }
.surface { box-sizing: border-box; border: 1rpx solid var(--tm-line); border-radius: 24rpx; background: var(--tm-surface-1); }
.row { display: flex; min-height: 96rpx; align-items: center; gap: 20rpx; padding: 20rpx 0; border-bottom: 1rpx solid var(--tm-line); }
.row:last-child { border-bottom: 0; }
.row-press { transition: background 120ms ease, opacity 120ms ease; }
.row-press:active { background: var(--tm-surface-2); opacity: .86; }
.row-main { min-width: 0; flex: 1; }
.row-title { overflow: hidden; color: var(--tm-text-1); font-size: 28rpx; font-weight: 550; text-overflow: ellipsis; white-space: nowrap; }
.row-meta { margin-top: 4rpx; color: var(--tm-text-3); font-size: 24rpx; line-height: 1.5; }
.row-side { flex: none; color: var(--tm-text-2); font-size: 24rpx; text-align: right; }
.status { display: inline-flex; align-items: center; gap: 10rpx; color: var(--tm-text-2); font-size: 24rpx; }
.status-dot { width: 10rpx; height: 10rpx; flex: none; border-radius: 50%; background: var(--tm-text-3); }
.status-success .status-dot { background: var(--tm-success); }
.status-warning .status-dot { background: var(--tm-warning); }
.status-danger .status-dot { background: var(--tm-danger); }
.status-info .status-dot { background: var(--tm-info); }
.btn { box-sizing: border-box; display: flex; width: 100%; min-height: 96rpx; align-items: center; justify-content: center; padding: 20rpx 28rpx; border-radius: 16rpx; color: var(--tm-text-1); font-size: 28rpx; font-weight: 600; line-height: 1.4; text-align: center; transition: transform 120ms ease, opacity 120ms ease, background 120ms ease; }
.btn:active { transform: scale(.985); opacity: .9; }
.btn-primary { background: var(--tm-accent); }
.btn-primary:active { background: var(--tm-accent-pressed); }
.btn-secondary { border: 1rpx solid var(--tm-line-strong); background: transparent; }
.btn-danger { border: 1rpx solid var(--tm-danger); color: #ff9aa7; background: transparent; }
.btn[disabled] { color: #8292a6; border-color: var(--tm-line); background: #152338; opacity: 1; }
.btn + .btn { margin-top: 16rpx; }
.text-button { min-height: 88rpx; padding: 0 12rpx; color: var(--tm-info); background: transparent; font-size: 26rpx; line-height: 88rpx; }
.notice { padding: 20rpx 24rpx; border-left: 4rpx solid var(--tm-info); border-radius: 8rpx; color: var(--tm-text-2); background: var(--tm-bg-raised); font-size: 26rpx; line-height: 1.55; }
.notice-warning { border-color: var(--tm-warning); }
.notice-danger { border-color: var(--tm-danger); }
.notice-success { border-color: var(--tm-success); }
.banner { display: flex; align-items: center; gap: 16rpx; margin-bottom: 24rpx; padding: 14rpx 18rpx; border-left: 4rpx solid var(--tm-warning); border-radius: 8rpx; color: var(--tm-text-2); background: var(--tm-bg-raised); font-size: 24rpx; }
.banner-text { min-width: 0; flex: 1; }
.form-label { display: block; margin: 24rpx 0 8rpx; color: var(--tm-text-2); font-size: 24rpx; }
.input { box-sizing: border-box; width: 100%; min-height: 88rpx; padding: 18rpx 24rpx; border: 1rpx solid var(--tm-line-strong); border-radius: 16rpx; color: var(--tm-text-1); background: var(--tm-surface-1); font-size: 28rpx; }
.detail-list { padding: 4rpx 24rpx; }
.detail-row { display: flex; gap: 24rpx; padding: 20rpx 0; border-bottom: 1rpx solid var(--tm-line); }
.detail-row:last-child { border-bottom: 0; }
.detail-key { width: 128rpx; flex: none; color: var(--tm-text-3); font-size: 24rpx; }
.detail-value { min-width: 0; flex: 1; color: var(--tm-text-1); font-size: 28rpx; word-break: break-word; }
.sr-only { position: absolute; width: 1px; height: 1px; margin: -1px; padding: 0; overflow: hidden; clip: rect(0, 0, 0, 0); border: 0; }

@media (max-width: 340px) {
  .page { padding-right: 24rpx; padding-left: 24rpx; }
  .section-title { font-size: 30rpx; }
}
